{
  "name": "openkittens",
  "version": "1.0.0",
  "private": true,
  "description": "Lokal hostbares Kartenspiel im Stil von Exploding Kittens - Mehrspieler im LAN, ohne Accounts.",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node test/game.test.js",
    "test:e2e": "node test/e2e.test.js",
    "test:ui": "node test/ui.test.js",
    "test:all": "npm test && npm run test:e2e && npm run test:ui"
  },
  "dependencies": {
    "express": "4.21.2",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "socket.io-client": "^4.8.4"
  }
}
